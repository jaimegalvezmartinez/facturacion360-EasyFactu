<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
	    war, no jar: la aplicacion se despliega dentro de un Tomcat de servidor,
	    no con su Tomcat embebido. ElArrancador (SpringBootServletInitializer)
	    es lo que permite que Spring arranque dentro de un contenedor externo.
	-->
	<packaging>war</packaging>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>edu.xtd</groupId>
	<artifactId>facturacion360</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>facturacion360</name>
	<description>Proeycto web para gestión de facturas online</description>
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>21</java.version>
		<maven.jar.forceCreation>true</maven.jar.forceCreation>
		<!--
		    La ofuscación va apagada porque rompe el despliegue en Tomcat
		    (Spring Boot no encuentra las clases renombradas). Ver el bloque
		    del plugin proguard-maven-plugin más abajo.
		-->
		<proguard.skip>true</proguard.skip>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<!--
			    Se quita el Tomcat embebido: en un WAR lo aporta el contenedor de
			    destino. Si se deja, el WAR arrastra su propio Tomcat y la app
			    acaba sirviendo con dos contenedores de por medio.
			-->
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
		    Servlet API en 'provided': la compila pero NO la mete en el WAR,
		    porque la implementacion la tiene que dar el Tomcat de destino.
		    spring-boot-starter-tomcat en vez de solo la API, porque es lo que
		    aporta el runtime que Spring necesita dentro del contenedor.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		    Autenticacion y autorizacion del portal. Aporta el filtro de seguridad que
		    exige sesion iniciada en TODO lo que no sea el login y los estaticos, el
		    encriptador BCrypt de contrasenas y el resto de la pieza. Es lo unico que
		    decide si una peticion pasa: los controladores no comprueban nada.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Documentación OpenAPI y Swagger UI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<!--
		    Plantilla del PDF. Se usa Thymeleaf y no una cadena construida a
		    mano en Java a propósito: th:text escapa por defecto, y el visor ya
		    tuvo tres XSS por interpolar datos del servidor en HTML sin escapar.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!--
		    Render del PDF en servidor. OJO: su motor es CSS 2.1, sin flexbox,
		    sin grid y sin custom properties, así que NO entiende la hoja del
		    visor (factura-imprimir.css) y el PDF lleva plantilla y estilos
		    propios. Que no se desincronicen lo vigila FacturaPdfEstilosTests.
		-->
		<dependency>
			<groupId>com.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-pdfbox</artifactId>
			<version>1.0.10</version>
		</dependency>
		<!--
		    Devtools queda en provided: sirve para el recarga en caliente al
		    desarrollar en el IDE, pero en un WAR desplegado es un estorbo
		    (intenta montar su propio classloader y puede soltar los logs de
		    fichero que usa logback-spring.xml).
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		    Base de datos en memoria SOLO para los tests: permite levantar el contexto
		    entero (y con el, la cadena de seguridad) sin depender de un MySQL ajeno.
		    MySQL sigue siendo el motor real; este no se usa nunca en produccion.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Herramientas de minificación: disponibles durante el build,
     excluidas del JAR de la aplicación por su alcance test. -->
		<dependency>
			<groupId>com.github.hazendaz</groupId>
			<artifactId>htmlcompressor</artifactId>
			<version>2.4.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.helger</groupId>
			<artifactId>ph-css</artifactId>
			<version>8.2.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.javascript</groupId>
			<artifactId>closure-compiler</artifactId>
			<version>v20260915</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration><argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine></configuration>
			</plugin>
			<!--
			    Ofuscación con ProGuard. DESACTIVADA por defecto (proguard.skip=true)
			    porque en un WAR rompe la aplicación: ProGuard renombra las clases y
			    Spring Boot las localiza por su nombre de paquete al montar el
			    contexto, así que los controladores dejan de aparecer y la aplicación
			    arranca sin ninguna ruta. En el JAR ejecutable sí funcionaba porque el
			    escaneo ocurría de otra manera.

			    Para volver a activarla en un entorno donde se haya medido que no
			    rompe nada: mvn package -Dproguard.skip=false
			-->
			<plugin>
				<groupId>com.github.wvengen</groupId>
				<artifactId>proguard-maven-plugin</artifactId>
				<version>2.6.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>proguard</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<skip>${proguard.skip}</skip>
					<proguardVersion>7.4.1</proguardVersion>
					<injar>${project.build.finalName}.war</injar>
					<proguardInclude>${project.basedir}/proguard-rules.pro</proguardInclude>
					<includeDependency>true</includeDependency>
					<includeDependencyInjar>false</includeDependencyInjar>
					<inLibsFilter>!META-INF/versions/**,!module-info.class</inLibsFilter>
					<libs>
						<lib>${java.home}/jmods</lib>
					</libs>
					<maxMemory>512m</maxMemory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				Declara la etiqueta @autor, que permite atribuir METODOS concretos dentro de
				clases compartidas. El @author estandar solo vale en clases e interfaces.
				placement "tm" = tipos y metodos.

				NO BORRAR sin quitar antes las etiquetas @autor del codigo: sin esta
				configuracion, javadoc las trata como desconocidas y falla la generacion.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<tags>
						<tag>
							<name>autor</name>
							<placement>tm</placement>
							<head>Autor:</head>
						</tag>
					</tags>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>produccion</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.4</version>
						<executions>
							<execution>
								<id>minificar-static</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>java</goal>
								</goals>
								<configuration>
									<mainClass>buildtools.MinificarStatic</mainClass>
									<classpathScope>test</classpathScope>
									<arguments>
										<argument>
											${project.build.outputDirectory}/static</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
