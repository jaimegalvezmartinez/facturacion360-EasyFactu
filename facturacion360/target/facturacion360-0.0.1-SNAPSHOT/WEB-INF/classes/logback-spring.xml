<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml" />
	<include resource="org/springframework/boot/logging/logback/console-appender.xml" />
	<!-- Ruta relativa al directorio de trabajo del proceso, no al proyecto: al lanzar
	     desde el IDE los ficheros caen en facturacion360/logs/. El patron de rotacion
	     lo deriva file-appender.xml de este mismo valor. -->
	<property name="LOG_FILE" value="logs/f.log"/>
	<include resource="org/springframework/boot/logging/logback/file-appender.xml" />
	<root level="INFO">
		<appender-ref ref="FILE" />
		<appender-ref ref="CONSOLE" />
	</root>
	<logger name="org.springframework" level="INFO"/>
	<logger name="edu.xtd" level="DEBUG"/>
</configuration>